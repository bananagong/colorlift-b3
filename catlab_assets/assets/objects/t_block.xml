<mujoco model="t_block">
  <!-- SI units. Bounding-box origin; cap points along +Y. Full size .2 x .2 x .025.
       Two touching boxes belong to ONE body. No convex mesh spanning the notches.
       Group 0 provides collision/inertia; group 1 provides massless visuals.
       MujocoXMLObject adds the free joint and instance name prefixes. -->
  <asset/>
  <worldbody>
    <body>
      <body name="object">
        <geom name="cap_collision" type="box" size="0.1 0.025 0.0125" pos="0 0.075 0"
              mass="0.17142857142857143" friction="0.5 0.005 0.0001" condim="4"
              solref="0.01 1" solimp="0.95 0.99 0.001" group="0" rgba="0.8 0.2 0.2 0"/>
        <geom name="stem_collision" type="box" size="0.025 0.075 0.0125" pos="0 -0.025 0"
              mass="0.12857142857142856" friction="0.5 0.005 0.0001" condim="4"
              solref="0.01 1" solimp="0.95 0.99 0.001" group="0" rgba="0.8 0.2 0.2 0"/>
        <geom name="cap_visual" type="box" size="0.1 0.025 0.0125" pos="0 0.075 0"
              mass="0" contype="0" conaffinity="0" group="1" rgba="0.08 0.48 0.85 1"/>
        <geom name="stem_visual" type="box" size="0.025 0.075 0.0125" pos="0 -0.025 0"
              mass="0" contype="0" conaffinity="0" group="1" rgba="0.08 0.48 0.85 1"/>
        <site name="cap_center" pos="0 0.075 0" size="0.003" rgba="0 0 0 0"/>
        <site name="stem_center" pos="0 -0.025 0" size="0.003" rgba="0 0 0 0"/>
        <site name="stem_tip" pos="0 -0.1 0" size="0.003" rgba="0 0 0 0"/>
      </body>
      <site name="bottom_site" pos="0 0 -0.0125" size="0.003" rgba="0 0 0 0"/>
      <site name="top_site" pos="0 0 0.0125" size="0.003" rgba="0 0 0 0"/>
      <site name="horizontal_radius_site" pos="0.1414213562373095 0 0" size="0.003" rgba="0 0 0 0"/>
    </body>
  </worldbody>
</mujoco>
